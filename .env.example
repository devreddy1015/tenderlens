DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web
POSTGRES_PASSWORD=tenderlens
# Comma-separated keys from ingest/sources.py, or "all" (35 GePNIC portals, docs/SOURCE_NOTES.md)
CRAWLER_SOURCES=all
CRAWLER_MIN_INTERVAL=1.0
LOG_LEVEL=INFO

# Public URL of the site (used for links in alert emails); true behind HTTPS
SITE_URL=http://localhost:8080
SECURE_COOKIES=false
# Google sign-in: OAuth client ID from Google Cloud Console (Web application)
GOOGLE_CLIENT_ID=
# Local development only: sign in with any email (needs DJANGO_DEBUG=true too)
DEV_LOGIN_ENABLED=false
# Email: Mailpit in development. Production example (Gmail + App Password):
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_HOST_USER=you@gmail.com
# EMAIL_HOST_PASSWORD=xxxx xxxx xxxx xxxx
DEFAULT_FROM_EMAIL=TenderLens <alerts@tenderlens.local>
FEEDBACK_NOTIFY_EMAIL=

# --- Copilot: self-hosted LLM (any OpenAI-compatible server, e.g. llama.cpp) ---
LLM_BASE_URL=http://localhost:8081/v1
LLM_MODEL=tenderlens-qwen3.5-4b
# Only if the LLM server was started with an API key
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=120
LLM_MAX_TOKENS=700
# Embeddings for document retrieval (downloaded on first use, runs on CPU)
EMBEDDING_MODEL=intfloat/multilingual-e5-small
# Optional cross-encoder reranker, e.g. BAAI/bge-reranker-base; empty = off
RERANKER_MODEL=
# Where uploaded tender PDFs are stored (a persistent volume in production)
MEDIA_ROOT=
# Largest PDF a user may upload, in MB
COPILOT_MAX_UPLOAD_MB=25

# --- Workspaces: OCDS ids are <OCDS_PREFIX>-<source>-<tender ID>; register a real prefix
# with the Open Contracting Partnership before publishing ---
OCDS_PREFIX=ocds-tenderlens
# Days an emailed workspace invitation stays valid; requests per minute per REST API key.
INVITE_MAX_AGE_DAYS=7
API_KEY_RATE_LIMIT=600/min

# --- Billing: fake (plans activate instantly; dev/tests) or razorpay. Unset: fake only
# when DJANGO_DEBUG is true, else razorpay (production never gives plans away). ---
BILLING_PROVIDER=fake
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret set in the Razorpay dashboard (verifies X-Razorpay-Signature)
RAZORPAY_WEBHOOK_SECRET=
# Razorpay plan ids (Dashboard > Subscriptions > Plans), one per paid plan and interval.
RAZORPAY_PLAN_PRO_MONTH=
RAZORPAY_PLAN_PRO_YEAR=
RAZORPAY_PLAN_TEAM_MONTH=
RAZORPAY_PLAN_TEAM_YEAR=

# Tests: give each parallel run its own database, e.g. TEST_DB_NAME=test_ci
# TEST_DB_NAME=

# =====================================================================================
# --- Production (deploy/compose.prod.yml, docs/DEPLOY.md) ---
# On the VPS: copy this file to .env, then set or uncomment everything below. The prod
# compose sets DJANGO_PRODUCTION=true, which refuses to start while any of the starred (*)
# values is missing or still a development value. `make prod-check` validates the result.
# =====================================================================================
# * Random, 50+ chars: python3 -c 'import secrets; print(secrets.token_urlsafe(64))'
# DJANGO_SECRET_KEY=
# DJANGO_DEBUG=false
# * Public origin; its host is always allowed and trusted for CSRF
# SITE_URL=https://tenders.example.in
# DJANGO_ALLOWED_HOSTS=tenders.example.in
# DJANGO_CSRF_TRUSTED_ORIGINS=https://tenders.example.in
# Caddy: the domain it gets a Let's Encrypt certificate for, and the expiry-notice address
# SITE_ADDRESS=tenders.example.in
# ACME_EMAIL=founder@example.in
# SECURE_HSTS_SECONDS=31536000
# * Database password (the prod Postgres is created with it on first start)
# POSTGRES_PASSWORD=
# add https://<domain> as a JS origin
# GOOGLE_CLIENT_ID=<id>.apps.googleusercontent.com
# DEFAULT_FROM_EMAIL=TenderLens <alerts@tenders.example.in>
# EMAIL_HOST=smtp-relay.brevo.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# FEEDBACK_NOTIFY_EMAIL=founder@example.in
# CRAWLER_SOURCES=all
# CRAWLER_MIN_INTERVAL=1.0
# Celery threads on the crawl queue (35 portals, <=1 req/s each)
# CRAWL_CONCURRENCY=24
# default queue: Copilot OCR/embeddings, alerts, emails
# WORKER_CONCURRENCY=2
# GUNICORN_WORKERS=2
# one thread per open Copilot answer stream (~80 s each)
# GUNICORN_THREADS=8
# default LLM_TIMEOUT_SECONDS + 60
# GUNICORN_TIMEOUT=
# Copilot LLM. Built-in CPU llama.cpp: COMPOSE_PROFILES=llm and LLM_BASE_URL=http://llm:8080/v1.
# A separate GPU box: its URL. None at all: leave the profile off; answers are extractive.
# COMPOSE_PROFILES=llm
# LLM_BASE_URL=http://llm:8080/v1
# LLM_MODEL=tenderlens-qwen3.5-4b
# LLM_GGUF=Qwen3.5-4B-Q4_K_M.gguf
# LLM_ALIAS=tenderlens-qwen3.5-4b
# LLM_THREADS=6
# LLM_BATCH_THREADS=8
# LLM_TIMEOUT_SECONDS=120
# baked into the image; another one = rebuild
# EMBEDDING_MODEL=intfloat/multilingual-e5-small
# * Billing: razorpay only (live keys from Dashboard > Account & Settings > API Keys)
# BILLING_PROVIDER=razorpay
# RAZORPAY_KEY_ID=rzp_live_
# RAZORPAY_KEY_SECRET=
# Webhook URL in the Razorpay dashboard: https://<domain>/api/billing/webhook
# RAZORPAY_WEBHOOK_SECRET=
# RAZORPAY_PLAN_PRO_MONTH=plan_
# RAZORPAY_PLAN_PRO_YEAR=plan_
# RAZORPAY_PLAN_TEAM_MONTH=plan_
# RAZORPAY_PLAN_TEAM_YEAR=plan_
# OCDS prefix registered with the Open Contracting Partnership (docs/DEPLOY.md)
# OCDS_PREFIX=ocds-xxxxxx
# Memory limits (docker compose mem_limit) and Postgres tuning, sized for 16 GB with the LLM
# WEB_MEM=2g
# WORKER_MEM=2g
# CRAWL_MEM=1g
# POSTGRES_MEM=2g
# LLM_MEM=5g
# PG_SHARED_BUFFERS=512MB
# PG_EFFECTIVE_CACHE_SIZE=1536MB
# Backups (deploy/backup.sh): local dir + retention, off-site remote via rclone env config
# BACKUP_DIR=/var/backups/tenderlens
# KEEP_DAYS=7
# BACKUP_REMOTE=offsite:tenderlens-backups
# REMOTE_KEEP_DAYS=30
# RCLONE_CONFIG_OFFSITE_TYPE=s3
# RCLONE_CONFIG_OFFSITE_PROVIDER=Cloudflare
# RCLONE_CONFIG_OFFSITE_ACCESS_KEY_ID=
# RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY=
# RCLONE_CONFIG_OFFSITE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# RCLONE_CONFIG_OFFSITE_NO_CHECK_BUCKET=true
# BACKUP_PING_URL=https://hc-ping.com/<uuid>
