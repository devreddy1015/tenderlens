DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web
POSTGRES_PASSWORD=tenderlens
CRAWLER_SOURCES=central
CRAWLER_MIN_INTERVAL=1.0
LOG_LEVEL=INFO

# Public URL of the site (used for links in alert emails); true behind HTTPS
SITE_URL=http://localhost:8080
SECURE_COOKIES=false
# Google sign-in: OAuth client ID from Google Cloud Console (Web application)
GOOGLE_CLIENT_ID=
# Local development only: sign in with any email (needs DJANGO_DEBUG=true too)
DEV_LOGIN_ENABLED=false
# Email: Mailpit in development. Production example (Gmail + App Password):
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_HOST_USER=you@gmail.com
# EMAIL_HOST_PASSWORD=xxxx xxxx xxxx xxxx
DEFAULT_FROM_EMAIL=TenderLens <alerts@tenderlens.local>
FEEDBACK_NOTIFY_EMAIL=
